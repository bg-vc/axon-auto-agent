{
  "name": "@axon-auto-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "out/main/index.js",
  "description": "GUI-first autonomous workbench powered by DeepSeek Harness",
  "author": "Axon Auto Agent contributors",
  "repository": { "type": "git", "url": "https://github.com/bg-vc/axon-auto-agent.git" },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:mac": "electron-builder --mac --arm64",
    "package:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@axon-auto-agent/contracts": "workspace:*",
    "@axon-auto-agent/runtime": "workspace:*",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "electron-updater": "6.8.9",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.13",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.4.27",
    "electron": "43.4.0",
    "electron-builder": "26.15.7",
    "electron-vite": "5.0.0",
    "jsdom": "28.1.0",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "ai.axon.autoagent",
    "productName": "Axon Auto Agent",
    "asar": true,
    "asarUnpack": ["node_modules/**/*.{node,dylib,so,dll}"],
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "extraResources": [
      { "from": "../../profiles/desktop", "to": "profiles/desktop", "filter": ["**/*"] }
    ],
    "publish": [{ "provider": "github", "owner": "bg-vc", "repo": "axon-auto-agent" }],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [{ "target": "dmg", "arch": ["arm64"] }, { "target": "zip", "arch": ["arm64"] }],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": { "sign": false, "artifactName": "${productName}-${version}-${arch}.${ext}" },
    "afterSign": "build/notarize.cjs"
  }
}
